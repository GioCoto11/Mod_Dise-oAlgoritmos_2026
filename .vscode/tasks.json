{
  // Tarea para compilar el archivo .c abierto con gcc (Ctrl + Shift + B)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar C con gcc",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-Wall",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
